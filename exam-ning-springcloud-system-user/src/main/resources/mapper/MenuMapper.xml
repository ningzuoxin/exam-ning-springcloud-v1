<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ning.infrastructure.persistence.dao.MenuDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.ning.infrastructure.persistence.model.MenuDO">
        <id column="id" property="id" />
        <result column="uid" property="uid" />
        <result column="menu_name" property="menuName" />
        <result column="parent_uid" property="parentUid" />
        <result column="sort_num" property="sortNum" />
        <result column="path" property="path" />
        <result column="component" property="component" />
        <result column="is_frame" property="isFrame" />
        <result column="menu_type" property="menuType" />
        <result column="status" property="status" />
        <result column="perms" property="perms" />
        <result column="icon" property="icon" />
        <result column="is_deleted" property="isDeleted" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, uid, menu_name, parent_uid, sort_num, path, component, is_frame, menu_type, status, perms, icon, is_deleted, create_time, update_time
    </sql>

    <!-- 根据用户ID查询菜单 -->
    <select id="selectMenusByUserId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT DISTINCT
        m.id,
        m.uid,
        m.menu_name,
        m.parent_uid,
        m.sort_num,
        m.path,
        m.component,
        m.is_frame,
        m.menu_type,
        m.status,
        m.perms,
        m.icon,
        m.is_deleted,
        m.create_time,
        m.update_time
        FROM
        sys_menu m
        INNER JOIN
        sys_role_menu rm ON m.uid = rm.menu_uid
        INNER JOIN
        sys_user_role ur ON rm.role_uid = ur.role_uid
        WHERE
        ur.user_uid = #{userId}
        AND m.status = 0
        AND m.is_deleted = 0
        ORDER BY
        m.parent_uid,
        m.sort_num
    </select>

</mapper>
